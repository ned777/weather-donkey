<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared background for the widget and app: a flat black card with a crisp
  2dp yellow retro outline. Used as android:background on each root layout.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_bg" />
            <corners android:radius="@dimen/widget_corner_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="2dp"
                android:color="@color/widget_border" />
            <corners android:radius="@dimen/widget_corner_radius" />
        </shape>
    </item>
</layer-list>
