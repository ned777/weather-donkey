<?xml version="1.0" encoding="utf-8"?>
<!-- One row of MainActivity's 5-day forecast list — inflated and filled in by MainActivity.populateForecast(). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <!-- Day + condition word stacked, so "Rainy"/"Snowy"/"Windy"/etc. is always spelled
         out here, not just implied by the icon. -->
    <LinearLayout
        android:layout_width="72dp"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/dayLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/retro_teal"
            android:textStyle="bold"
            android:textSize="15sp"
            android:text="--" />

        <TextView
            android:id="@+id/conditionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/retro_pink"
            android:textSize="12sp"
            android:text="--" />

    </LinearLayout>

    <ImageView
        android:id="@+id/conditionIcon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginEnd="10dp"
        android:src="@drawable/ic_weather_cloudy" />

    <TextView
        android:id="@+id/highLowText"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textColor="@color/retro_white"
        android:textSize="15sp"
        android:text="H:--°  L:--°" />

</LinearLayout>
