<?xml version="1.0" encoding="utf-8"?>
<!-- One row of MainActivity's 5-day forecast list — inflated and filled in by MainActivity.populateForecast(). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/dayLabel"
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:textColor="@color/retro_teal"
        android:textStyle="bold"
        android:textSize="15sp"
        android:text="--" />

    <TextView
        android:id="@+id/conditionEmoji"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:textSize="18sp"
        android:text="" />

    <TextView
        android:id="@+id/highLowText"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textColor="@color/retro_white"
        android:textSize="15sp"
        android:text="H:--°  L:--°" />

</LinearLayout>
