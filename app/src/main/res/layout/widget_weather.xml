<?xml version="1.0" encoding="utf-8"?>
<!--
  Layout: big current temp top-left, location/condition/sunrise-sunset
  stacked tight (no vertical gap) top-right, today's high/low right under
  the big temp, and a two-day forecast row filling the bottom half — each
  forecast cell shows its condition as a word underneath the high/low, not
  an icon (no icons anywhere in this widget, by request). Every row below
  the top row is toggled visible/gone in code (WeatherWidgetProvider —
  buildViews()) based on the widget's current on-screen size. All text is
  set in code; nothing here ever changes except through that.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/weatherWidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:paddingTop="24dp"
    android:paddingBottom="16dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Top-left: big current temperature, today's high/low right under it. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="start">

            <TextView
                android:id="@+id/tempText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="@color/retro_cyan"
                android:textSize="52sp"
                android:textStyle="bold"
                android:shadowColor="@color/retro_cyan"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="14"
                android:text="--°" />

            <TextView
                android:id="@+id/todayHighLowText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="@color/retro_white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="H:--°  L:--°" />

        </LinearLayout>

        <!-- Top-right: location, then condition, then sunrise/sunset — one line each, no gap. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/locationText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="@color/retro_teal"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/current_location" />

            <!-- No icon here per request — just the condition word. -->
            <TextView
                android:id="@+id/conditionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="@color/retro_pink"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="--" />

            <!-- Sunrise and sunset each get their own line — not a side-by-side row. -->
            <LinearLayout
                android:id="@+id/sunRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:id="@+id/sunriseText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textColor="@color/retro_white"
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="↑ --:--" />

                <TextView
                    android:id="@+id/sunsetText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textColor="@color/retro_white"
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="↓ --:--" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- Bottom half: the next two days, high/low. -->
    <LinearLayout
        android:id="@+id/forecastRow"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/forecast1Day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="@color/retro_teal"
                android:textStyle="bold"
                android:textSize="13sp"
                android:text="--" />

            <TextView
                android:id="@+id/forecast1HighLow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="@color/retro_white"
                android:textSize="13sp"
                android:text="--°/--°" />

            <!-- Condition word underneath, no icon. -->
            <TextView
                android:id="@+id/forecast1Condition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="@color/retro_pink"
                android:textSize="11sp"
                android:text="--" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/forecast2Day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="@color/retro_teal"
                android:textStyle="bold"
                android:textSize="13sp"
                android:text="--" />

            <TextView
                android:id="@+id/forecast2HighLow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="@color/retro_white"
                android:textSize="13sp"
                android:text="--°/--°" />

            <!-- Condition word underneath, no icon. -->
            <TextView
                android:id="@+id/forecast2Condition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="@color/retro_pink"
                android:textSize="11sp"
                android:text="--" />

        </LinearLayout>

    </LinearLayout>

    <!-- Only visible when there's an actual status message (permission prompt, loading, error) — hidden once real data is showing cleanly. -->
    <TextView
        android:id="@+id/updatedText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:textColor="@color/retro_white_dim"
        android:textSize="10sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:visibility="gone"
        android:text="" />

</LinearLayout>
