<?xml version="1.0" encoding="utf-8"?>
<!--
  MainActivity's screen: a full-size version of the widget's content, plus
  a Fahrenheit/Celsius toggle, a 5-day forecast list, and a
  location-permission prompt when needed. Refreshing is swipe-down only
  (SwipeRefreshLayout) — there is no separate Refresh button and nothing
  fetches automatically on launch/resume, matching the widget's own
  tap-only rule (see MainActivity.kt).
-->
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_title"
                android:textColor="@color/retro_yellow"
                android:textSize="24sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:shadowColor="@color/retro_yellow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="12"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_subtitle"
                android:textColor="@color/retro_white_dim"
                android:textSize="14sp"
                android:textStyle="italic"
                android:layout_marginBottom="16dp" />

            <!-- One tab per location: "Current" (GPS, always first/default) + any searched
                 cities the user has added, plus a "+" tab that opens the search dialog
                 instead of ever actually being selected — see MainActivity.setupTabs(). -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                app:tabMode="scrollable"
                app:tabGravity="start"
                app:tabIndicatorColor="@color/retro_cyan"
                app:tabSelectedTextColor="@color/retro_cyan"
                app:tabTextColor="@color/retro_white_dim"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <Button
                    android:id="@+id/fahrenheitButton"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/unit_fahrenheit"
                    android:textStyle="bold"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:textColor="@color/retro_white_dim"
                    android:text="|" />

                <Button
                    android:id="@+id/celsiusButton"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/unit_celsius"
                    android:textStyle="bold"
                    android:textSize="18sp" />

            </LinearLayout>

            <!-- Which location this is is already shown by the selected tab above, so this
                 spot mirrors the widget's own "TODAY" label instead of repeating the city name. -->
            <TextView
                android:id="@+id/todayLabelText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/retro_teal"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:text="@string/widget_today_label" />

            <TextView
                android:id="@+id/tempText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/retro_cyan"
                android:textSize="130sp"
                android:textStyle="bold"
                android:shadowColor="@color/retro_cyan"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="26"
                android:text="--°" />

            <TextView
                android:id="@+id/todayHighLowText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/retro_white"
                android:textSize="19sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"
                android:text="H:--°  L:--°" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/conditionIcon"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_weather_cloudy" />

                <TextView
                    android:id="@+id/conditionText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/retro_pink"
                    android:textSize="23sp"
                    android:textStyle="bold"
                    android:text="--" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/sunriseText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/retro_white"
                    android:textSize="17sp"
                    android:text="↑ Sunrise --:--" />

                <TextView
                    android:layout_width="16dp"
                    android:layout_height="wrap_content"
                    android:text="" />

                <TextView
                    android:id="@+id/sunsetText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/retro_white"
                    android:textSize="17sp"
                    android:text="↓ Sunset --:--" />

            </LinearLayout>

            <TextView
                android:id="@+id/removeLocationButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/remove_location"
                android:textColor="@color/retro_pink"
                android:textSize="13sp"
                android:padding="6dp"
                android:layout_marginBottom="4dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/updatedText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/retro_white_dim"
                android:textSize="13sp"
                android:layout_marginBottom="16dp"
                android:text="" />

            <Button
                android:id="@+id/grantPermissionButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/grant_location"
                android:layout_marginBottom="16dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/forecastHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/retro_yellow"
                android:textStyle="bold"
                android:textSize="17sp"
                android:letterSpacing="0.06"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"
                android:text="@string/forecast_header"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/forecastContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

    </ScrollView>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
